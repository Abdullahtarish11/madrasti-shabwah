* {
  box-sizing: border-box;
}

:root {
  --bg: #f5f7f5;
  --panel: #ffffff;
  --panel-alt: #eef9f3;
  --primary: #1e7a5d;
  --primary-dark: #135d46;
  --secondary: #0d9488;
  --text: #132318;
  --muted: #5d6a62;
  --border: #d9e5df;
  --shadow: 0 10px 24px rgba(24, 57, 45, 0.08);
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: 'Tahoma', 'Segoe UI', sans-serif;
  background: linear-gradient(180deg, #f4faf7 0%, #edf5f0 100%);
  color: var(--text);
  direction: rtl;
}

button,
input,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  max-width: 1280px;
  margin: 0 auto;
  padding: 20px 16px 48px;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 18px 20px;
  margin-bottom: 24px;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(8px);
  border: 1px solid var(--border);
  border-radius: 18px;
  box-shadow: var(--shadow);
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-mark {
  display: grid;
  place-items: center;
  width: 46px;
  height: 46px;
  border-radius: 14px;
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  color: white;
  font-weight: 700;
  font-size: 1.4rem;
}

.eyebrow {
  margin: 0;
  color: var(--muted);
  font-size: 0.72rem;
}

.brand-wrap h1 {
  margin: 0;
  font-size: 1.4rem;
}

.nav-menu {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8px;
}

.nav-button {
  border: 1px solid transparent;
  background: transparent;
  color: var(--text);
  border-radius: 999px;
  padding: 10px 14px;
  transition: 0.2s ease;
}

.nav-button.active,
.nav-button:hover {
  background: var(--panel-alt);
  border-color: var(--border);
}

.page-shell {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 20px;
  box-shadow: var(--shadow);
}

.hero {
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 20px;
  padding: 24px;
}

.hero-copy {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.badge {
  display: inline-flex;
  align-self: flex-start;
  padding: 8px 12px;
  background: rgba(30, 122, 93, 0.12);
  color: var(--primary-dark);
  border-radius: 999px;
  font-size: 0.8rem;
  margin-bottom: 14px;
}

.hero h2 {
  margin: 0 0 12px;
  font-size: clamp(2rem, 4vw, 3rem);
  line-height: 1.3;
}

.hero p {
  margin: 0;
  color: var(--muted);
  line-height: 1.8;
  font-size: 1.05rem;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 24px;
}

.hero-actions button,
.action-row button,
.content-card button {
  border: none;
  border-radius: 12px;
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  color: white;
  padding: 12px 18px;
  font-weight: 600;
}

.hero-actions .secondary,
.action-row .secondary,
.content-card .secondary {
  background: var(--panel-alt);
  color: var(--primary-dark);
  border: 1px solid var(--border);
}

.hero-panel {
  display: flex;
  align-items: center;
  justify-content: center;
}

.mini-stat-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(120px, 1fr));
  gap: 16px;
  width: 100%;
}

.mini-stat {
  padding: 20px 16px;
  border-radius: 18px;
  background: linear-gradient(180deg, #f1faf5 0%, #ffffff 100%);
  border: 1px solid var(--border);
  text-align: center;
}

.mini-emoji {
  display: block;
  font-size: 1.8rem;
  margin-bottom: 8px;
}

.mini-stat strong {
  display: block;
  font-size: 1.6rem;
}

.mini-stat small {
  color: var(--muted);
}

.stats-row,
.card-grid,
.search-results-grid {
  display: grid;
  gap: 18px;
}

.stats-row {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.info-card,
.content-card {
  padding: 22px 20px;
}

.feature-icon {
  display: inline-grid;
  place-items: center;
  width: 46px;
  height: 46px;
  border-radius: 14px;
  background: rgba(30, 122, 93, 0.1);
  font-size: 1.4rem;
}

.info-card h3,
.content-card h3,
.search-panel h3 {
  margin: 14px 0 10px;
}

.info-card p,
.content-card p,
.search-panel p {
  margin: 0;
  color: var(--muted);
  line-height: 1.7;
}

.section-block {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.section-head {
  display: flex;
  flex-wrap: wrap;
  align-items: end;
  justify-content: space-between;
  gap: 10px;
}

.section-head h2 {
  margin: 0;
  font-size: 2rem;
}

.section-head span {
  color: var(--muted);
}

.three-col {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.two-col {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.content-card {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
}

.card-header h3 {
  margin: 0;
  font-size: 1.2rem;
}

.card-header span,
.book-meta span,
.content-card small {
  color: var(--primary-dark);
  background: rgba(30, 122, 93, 0.08);
  border-radius: 999px;
  padding: 6px 10px;
  font-size: 0.76rem;
}

.content-card ul {
  margin: 0;
  padding-right: 18px;
  color: var(--muted);
  line-height: 1.8;
}

.tag-list,
.subject-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  list-style: none;
  margin: 0;
  padding: 0;
}

.tag-list li,
.subject-list li {
  background: #f1f7f3;
  border: 1px solid var(--border);
  border-radius: 999px;
  padding: 6px 10px;
  font-size: 0.8rem;
  color: var(--text);
}

.divider {
  height: 1px;
  background: var(--border);
}

.book-card {
  min-height: 250px;
}

.book-meta,
.book-detail-row,
.action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  flex-wrap: wrap;
}

.book-detail-row {
  color: var(--muted);
  font-size: 0.82rem;
}

.action-row {
  margin-top: auto;
}

.filter-row {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.filter-row label {
  font-weight: 600;
}

.filter-row select,
.search-box-wrap input {
  width: min(100%, 360px);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 12px 14px;
  background: white;
  color: var(--text);
}

.search-box-wrap {
  display: flex;
  justify-content: center;
}

.search-results-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.search-panel {
  padding: 22px 20px;
}

.search-panel ul {
  margin: 14px 0 0;
  padding-right: 18px;
  color: var(--muted);
  line-height: 2;
}

@media (max-width: 860px) {
  .topbar,
  .hero,
  .stats-row,
  .three-col,
  .two-col,
  .search-results-grid {
    grid-template-columns: 1fr;
  }

  .topbar {
    position: static;
    display: block;
  }

  .brand-wrap {
    margin-bottom: 12px;
  }

  .nav-menu {
    justify-content: flex-start;
  }

  .hero {
    display: flex;
    flex-direction: column;
  }

  .stats-row {
    display: grid;
  }
}
